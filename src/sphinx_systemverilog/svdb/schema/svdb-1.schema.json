        "base": {"$ref": "#/$defs/Ref", "description": "The immediate base class; its target is the key the stitcher follows inherited methods to."},
        "kind": {"enum": ["component", "port"]},
        "tier": {"type": "string", "description": "sequencer, driver, monitor, agent, env, test, analysis, or empty."},
        "ports": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string"},
              "type": {"$ref": "#/$defs/Ref"},
              "role": {"enum": ["port", "export", "imp"]},
              "link": {"$ref": "#/$defs/uvm_link"},
              "declared_by": {"type": "string"}
            }
          }
        },
        "methods": {
          "type": "object", "additionalProperties": {"$ref": "#/$defs/uvm_method"},
          "description": "Keyed by the name of every function this class itself defines; a missing key means it is inherited."
