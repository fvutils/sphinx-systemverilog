    "uvm_step": {"type": "integer", "minimum": 0,
                 "description": "0-based position of a call in a syntax-order enumeration of the call expressions in its method's body. Shared by uvm.child, uvm.conn, uvm.override and methods.*.calls of the same method."},
    "uvm_method": {
      "type": "object", "additionalProperties": false,
      "description": "A function the class itself defines.",
      "properties": {
        "virtual": {"type": "boolean"},
        "calls": {
          "type": "array",
          "description": "Calls the stitcher can follow: unqualified, this. or super. calls to a function of this class or its bases.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["step", "method"],
            "properties": {
              "step": {"$ref": "#/$defs/uvm_step"},
              "method": {"type": "string"},
              "super": {"type": "boolean", "description": "A super.m() call: bound from the base of the defining class."},
              "conditional": {"type": "boolean"},
              "multiplicity": {"type": "string"}
            }
          }
        }
      }
    },
